CONFIG_IDF_TARGET_ESP32S3=y
CONFIG_IDF_TARGET="esp32s3"

# Flash QIO 80MHz 16MB
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
#CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80MHZ=y

# Octal PSRAM 8MB (N16R8)
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SIZE=8388608

# Bootloader SPI自动探测（小智固件同款）
CONFIG_BOOTLOADER_SPI_AUTO_DETECT=y

# 使用IDF默认分区表，不要自定义partitions.csv
CONFIG_PARTITION_TABLE_DEFAULT=y
#CONFIG_PARTITION_TABLE_CUSTOM=n

CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

CONFIG_ESP_WIFI=y
CONFIG_ESP_WIFI_AP=y
CONFIG_ESP_WIFI_STA=y
CONFIG_ESP_NETIF=y
CONFIG_I2S_ENABLED=y
CONFIG_NVS_FLASH=y
