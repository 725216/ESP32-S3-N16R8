#
# Chip target
#
CONFIG_CHIP_ESP32S3=y
CONFIG_IDF_TARGET="esp32s3"

#
# CPU & Clock
#
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_CPU_FREQ_240=y
CONFIG_ESP32S3_USE_32BIT_ACCESS=y

#
# Flash Configuration DIO 40MHz 16MB
#
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40MHZ=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

#
# PSRAM OPI 8MB（N16R8模组必须开启OPI）
#
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SIZE=8388608
CONFIG_SPIRAM_USE_MALLOC=y

#
# NVS 存储（保存WiFi账号密码）
#
CONFIG_NVS_FLASH=y
CONFIG_NVS_ENCRYPTION=n
CONFIG_NVS_PART_NAME="nvs"

#
# WiFi & 事件系统
#
CONFIG_WIFI=y
CONFIG_ESP_WIFI_STA=y
CONFIG_ESP_WIFI_AP=y
CONFIG_ESP_WIFI_SCAN_METHOD_FAST=y
CONFIG_ESP_EVENT=y

#
# HTTP Web服务器（网页配网）
#
CONFIG_ESP_HTTP_SERVER=y
CONFIG_HTTPD_PURGE_BUF_LEN=1024

#
# BROOKESIA 语音框架
#
CONFIG_BROOKESIA_ENABLE=y
CONFIG_BROOKESIA_AGENT_XIAOZHI=y
CONFIG_BROOKESIA_AGENT_COZE=y
CONFIG_BROOKESIA_AGENT_DOUBAO=y

#
# GPIO / LED Strip (WS2812 RGB GPIO48)
#
CONFIG_LED_STRIP_ENABLE=y
CONFIG_RMT_ISR_IRAM_SAFE=y

#
# Log 输出
#
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_CONSOLE_UART_DEFAULT=y

#
# FreeRTOS基础
#
CONFIG_FREERTOS_HZ=100
